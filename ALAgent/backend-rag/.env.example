# OpenAI API Key (optional, for OpenAI models)
OPENAI_API_KEY=your-openai-api-key-here

# DashScope API Key (for Qwen embedding models)
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# Embedding Models (支持多模态：图片、视频)
# 文本向量化模型
TEXT_EMBEDDING_MODEL=text-embedding-v4
# 多模态向量化模型（支持图片、视频）
MULTIMODAL_EMBEDDING_MODEL=qwen2.5-vl-embedding
# 向量维度
TEXT_EMBEDDING_DIM=1024
MULTIMODAL_EMBEDDING_DIM=1024

# LLM 配置 (用于 LightRAG 知识图谱提取)
LLM_MODEL=qwen-plus
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# LightRAG 配置
# 工作目录（存储知识图谱和索引数据）
LIGHTRAG_WORKING_DIR=./lightrag_data
# 查询模式: naive | local | global | hybrid | mix
# - naive: 标准向量检索（类似传统 RAG）
# - local: 使用局部知识图谱上下文
# - global: 使用全局图谱模式和社区结构
# - hybrid: 结合 local 和 global（推荐）
# - mix: 结合所有模式 + 重排序
LIGHTRAG_QUERY_MODE=hybrid
# 知识图谱存储后端: json | neo4j | mongodb | postgres
LIGHTRAG_GRAPH_STORAGE=json
# 向量存储后端: milvus | faiss | chroma | qdrant
LIGHTRAG_VECTOR_STORAGE=milvus

# Milvus settings
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=default

# GitHub settings (for private repos)
GITHUB_TOKEN=

# Evaluation settings
EVALUATION_DATASET=./data/evaluation/golden_dataset.json

# Server settings
HOST=0.0.0.0
PORT=8228
DEBUG=true

# Chunking settings
MAX_CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# Retrieval settings
DEFAULT_TOP_K=5
