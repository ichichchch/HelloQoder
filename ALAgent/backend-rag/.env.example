# OpenAI API Key for embeddings
OPENAI_API_KEY=your-openai-api-key-here

# Milvus settings
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=default

# GitHub settings (for private repos)
GITHUB_TOKEN=

# Evaluation settings
EVALUATION_DATASET=./data/evaluation/golden_dataset.json

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Chunking settings
MAX_CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# Retrieval settings
DEFAULT_TOP_K=5
